# Telegram Alerts Configuration
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Stake & Automation Settings
STAKE_BASE_URL=https://stake.com
STAKE_SESSION_COOKIE=
STAKE_2FA_SECRET=your_google_authenticator_totp_secret_here
SIMULATION_MODE=true

# Autonomous Decision & Dynamic Bet Sizing Settings
ENABLE_DYNAMIC_SIZING=true
BASE_BANKROLL_PERCENT=0.02
MIN_STAKE=0.50
BET_AMOUNT=1.00
MAX_BET_CAP=10.00
MIN_CONFIDENCE_THRESHOLD=0.75
MIN_ODDS=1.40
MAX_ODDS=4.50
DAILY_STOP_LOSS=50.00
MAX_DAILY_BETS=4
MAX_WEEKLY_BETS=25
ALLOWED_LEAGUES=Premier League,Champions League,LaLiga,Serie A,Bundesliga,MLS
POLL_INTERVAL_SECONDS=15

# Gemini AI Agent (Full Agent Mode)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_AI_MODE=agent
